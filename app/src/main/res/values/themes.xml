<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Myra" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/myra_red</item>
        <item name="colorPrimaryVariant">@color/myra_red</item>
        <item name="colorSecondary">@color/myra_purple</item>
        <item name="android:windowBackground">@color/myra_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/myra_bg</item>
        <item name="android:textColorPrimary">@color/myra_text</item>
        <item name="android:textColorHint">@color/myra_hint</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#888888</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">#EEEEEE</item>
        <item name="android:textColorHint">#555555</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
