<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_mesh"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingTop="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.3"
            android:text="SETTINGS"
            android:textColor="#FF1744"
            android:textSize="22sp" />

        <TextView style="@style/Label" android:text="API KEY" />
        <EditText
            android:id="@+id/apiKeyInput"
            style="@style/Field"
            android:hint="Gemini API key"
            android:inputType="textPassword" />

        <TextView style="@style/Label" android:text="YOUR NAME" />
        <EditText
            android:id="@+id/userNameInput"
            style="@style/Field"
            android:hint="Tumhara naam"
            android:inputType="textPersonName" />

        <TextView style="@style/Label" android:text="AI MODEL" />
        <Spinner
            android:id="@+id/modelSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:popupBackground="#111111" />

        <TextView style="@style/Label" android:text="VOICE" />
        <Spinner
            android:id="@+id/voiceSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:popupBackground="#111111" />

        <TextView style="@style/Label" android:text="PERSONALITY" />
        <RadioGroup
            android:id="@+id/personalityGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioGF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#FF1744"
                android:text="GF Mode 💖"
                android:textColor="#EEEEEE" />

            <RadioButton
                android:id="@+id/radioPro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#FF1744"
                android:text="Professional Mode 💼"
                android:textColor="#EEEEEE" />

            <RadioButton
                android:id="@+id/radioAssistant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#FF1744"
                android:text="Assistant Mode 🤖"
                android:textColor="#EEEEEE" />
        </RadioGroup>

        <TextView style="@style/Label" android:text="PRIME CONTACTS ⭐" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/primeRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/addPrimeBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_prime_badge"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:padding="12dp"
            android:text="ADD PRIME CONTACT"
            android:textColor="#FF1744"
            android:textSize="13sp" />

        <TextView style="@style/Label" android:text="ACCESSIBILITY" />
        <TextView
            android:id="@+id/accessibilityStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_save_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:padding="14dp"
            android:text="SAVE"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
